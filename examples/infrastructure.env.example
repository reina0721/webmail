# Infrastructure only. Configure the site and Stalwart in /console/setup/ after startup.
MAIL_WEB_VERSION=0.4.0-alpha.12
CONTAINER_NAME=mail-web
LISTEN_ADDRESS=127.0.0.1
PORT=18090
ALLOW_HTTP=false
# Optional exact IP URL for an HTTP backup entry when listening on a wildcard.
DIRECT_ACCESS_ORIGIN=
RELEASE_REPOSITORY=reina0721/webmail
RUST_LOG=mail_web=info,tower_http=warn
TRUSTED_PROXY_IPS=
